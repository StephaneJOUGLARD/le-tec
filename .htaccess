# le-tec.fr — hébergement OVH (Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Forcer HTTPS et le domaine sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://le-tec.fr/$1 [R=301,L]
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(woff2|svg|png|jpg|css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/rss+xml
</IfModule>
AddType font/woff2 .woff2
AddType application/rss+xml .xml

# Fichiers internes du dépôt : jamais servis
<FilesMatch "\.(md|py)$">
  Require all denied
</FilesMatch>

# Métier « Économie de la construction & AMO » : prochainement
Redirect 302 /economie-de-la-construction.html https://le-tec.fr/nos-metiers.html
